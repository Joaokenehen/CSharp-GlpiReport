<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RelatorioGLPIApp.ViewModels"
             x:Class="RelatorioGLPIApp.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             x:Name="RootControl"
             Background="#F8F9FA">

    <UserControl.Styles>
        <Style Selector="Button.WindowButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.WindowButton:pointerover">
            <Setter Property="Background" Value="#E9ECEF"/>
        </Style>
        <Style Selector="Button.CloseButton:pointerover">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- ESTILO PARA CENTRALIZAR O TEXTO DO DATEPICKER -->
        <Style Selector="DatePicker TextBox.DatePickerTextBox">
            <!-- Padding="0" anula o padding padrão que pode desalinhar o texto -->
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- 1. CABEÇALHO MODERNO -->
        <Border Grid.Row="0" Background="White" BoxShadow="0 4 15 0 #0D000000" ZIndex="1">
            <Grid RowDefinitions="Auto,Auto">

                <!-- LINHA 1: Título da Janela e Controles -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" MinHeight="40" Name="TitleBar" PointerPressed="TitleBar_PointerPressed" Background="Transparent">
                    <TextBlock Grid.Column="0" Text="Gerador de Relatórios" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" Margin="20,0,0,0" Foreground="#2B3035"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,10,0">
                        <!-- BOTÕES DE NAVEGAÇÃO -->
                        <Button Content="Dashboard"
                                IsEnabled="False"
                                Background="#343a40"
                                Foreground="White"
                                Padding="10,5"
                                CornerRadius="4"
                                Margin="0,0,5,0"/>
                        <Button Content="Relatórios Gerais"
                                Command="{Binding NavigateToGeneralReportsCommand}"
                                Background="#6c757d"
                                Foreground="White"
                                Padding="10,5"
                                CornerRadius="4"
                                Margin="0,0,5,0"/>
                        <Button Content="Relatórios de Técnicos"
                                Command="{Binding NavigateToTechnicianReportsCommand}"
                                Background="#6c757d"
                                Foreground="White"
                                Padding="10,5"
                                CornerRadius="4"
                                Margin="0,0,10,0"/>
                        <!-- BOTÃO DE CONFIGURAÇÕES -->
                        <Button Classes="WindowButton">
                            <PathIcon Data="M19.43 12.98c.04-.32.07-.64.07-.98s-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.3-.61-.22l-2.49 1c-.52-.4-1.08-.73-1.69-.98l-.38-2.65C14.46 2.18 14.25 2 14 2h-4c-.25 0-.46.18-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1c-.23-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64l2.11 1.65c-.04.32-.07.65-.07.98s.03.66.07.98l-2.11 1.65c-.19.15-.24.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.03.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.38-2.65c.61.25 1.17-.59 1.69.98l2.49 1c.23.09.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.65zM12 15.5c-1.93 0-3.5-1.57-3.5-3.5s1.57-3.5 3.5-3.5 3.5 1.57 3.5 3.5-1.57 3.5-3.5 3.5z"
                                      Width="16" Height="16"/>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Sair" Command="{Binding SairCommand}"/>
                                    <Separator />
                                    <MenuItem Header="Relatórios do Dia Salvos" ItemsSource="{Binding SavedReports}">
                                        <MenuItem.ItemTemplate>
                                            <DataTemplate>
                                                <!-- O Header é o nome do arquivo, o CommandParameter também -->
                                                <MenuItem Header="{Binding}">
                                                    <MenuItem Header="Carregar" Command="{Binding #RootControl.DataContext.LoadDashboardReportCommand}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Excluir" Command="{Binding #RootControl.DataContext.DeleteDashboardReportCommand}" CommandParameter="{Binding}"/>
                                                </MenuItem>
                                            </DataTemplate>
                                        </MenuItem.ItemTemplate>
                                    </MenuItem>
                                    <MenuItem Header="Relatórios Gerais Salvos" ItemsSource="{Binding SavedGeneralReports}">
                                        <MenuItem.ItemTemplate>
                                            <DataTemplate>
                                                <MenuItem Header="{Binding}">
                                                    <MenuItem Header="Carregar" Command="{Binding #RootControl.DataContext.LoadGeneralReportAndNavigateCommand}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Excluir" Command="{Binding #RootControl.DataContext.DeleteGeneralReportCommand}" CommandParameter="{Binding}"/>
                                                </MenuItem>
                                            </DataTemplate>
                                        </MenuItem.ItemTemplate>
                                    </MenuItem>
                                    <MenuItem Header="Relatórios de Técnicos Salvos" ItemsSource="{Binding SavedTechnicianReports}">
                                        <MenuItem.ItemTemplate>
                                            <DataTemplate>
                                                <MenuItem Header="{Binding}">
                                                    <MenuItem Header="Carregar" Command="{Binding #RootControl.DataContext.LoadTechnicianReportAndNavigateCommand}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Excluir" Command="{Binding #RootControl.DataContext.DeleteTechnicianReportCommand}" CommandParameter="{Binding}"/>
                                                </MenuItem>
                                            </DataTemplate>
                                        </MenuItem.ItemTemplate>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Border Background="#DEE2E6" Width="1" Margin="0,8" VerticalAlignment="Stretch"/>
                        <Button Name="MinimizeButton" Content="—" Classes="WindowButton" Click="MinimizeWindow"/>
                        <Button Name="MaximizeButton" Content="☐" Classes="WindowButton" Click="MaximizeWindow"/>
                        <Button Name="CloseButton" Content="✕" Classes="WindowButton CloseButton" Click="CloseWindow"/>
                    </StackPanel>
                </Grid>

                <!-- LINHA 2: Barra de Ações (Filtros e Botões) -->
                <Border Grid.Row="1" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0">
                    <WrapPanel Margin="20,10,10,10" VerticalAlignment="Center">
                        <!-- KPIs -->
                        <Border Background="#E9ECEF" CornerRadius="6" Padding="10,5" Margin="0,0,20,5">
                            <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                                <TextBlock>
                                    <Run Text="Abertos no Dia: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding TotalChamadosAbertos}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Solucionados: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding TotalItensSolucionados}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Itens no Relatório: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding TotalItensRelatorio}" FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Data Filter -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,20,5">
                            <TextBlock Text="Data:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#6C757D"/>
                            <DatePicker SelectedDate="{Binding DataSelecionada}" Height="35" CornerRadius="6"/>
                        </StackPanel>

                        <!-- User Filter -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,20,5">
                            <TextBlock Text="Usuário:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#6C757D"/>
                            <TextBox Text="{Binding UsuarioTi}" Watermark="Ex: joao.gustavo" Width="140" Height="35" CornerRadius="6" Padding="10,6">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding BuscarChamadosCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>

                        <!-- Search Button -->
                        <Button Command="{Binding BuscarChamadosCommand}"
                                IsEnabled="{Binding !IsSearching}"
                                Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1"
                                Foreground="#495057" Padding="15,7" CornerRadius="6" Cursor="Hand"
                                VerticalAlignment="Center" Margin="0,0,20,5"
                                MinWidth="150" HorizontalContentAlignment="Center"
                                Content="{Binding BuscarChamadosButtonText}" />

                        <!-- Separator -->
                        <Border Background="#DEE2E6" Width="1" Height="25" VerticalAlignment="Center" Margin="0,0,20,5"/>

                        <!-- Manual Add -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,0,5">
                            <!-- NOVO BOTÃO DE SALVAR -->
                            <Button Background="Transparent" Padding="8" CornerRadius="6" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="Salvar Relatório Atual">
                                <PathIcon Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"
                                          Width="20" Height="20" Foreground="#495057"/>
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">

                                        <StackPanel Spacing="10" Margin="10">
                                            <TextBlock Text="Nome do Relatório:" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding ReportSaveName}" Watermark="Ex: Relatório Semanal" MinWidth="250" KeyDown="TextBox_KeyDown"/>
                                            <Button Content="Salvar" Command="{Binding SaveStateCommand}" HorizontalAlignment="Stretch"
                                                    Classes="accent"/>

                                            <!-- Seção de Nomes Recentes -->
                                            <Panel IsVisible="{Binding SavedReports.Count}">
                                                <StackPanel>
                                                    <Separator Margin="0,10"/>
                                                    <TextBlock Text="Ou clique em um nome recente para usar:" FontSize="12" Foreground="#6C757D" Margin="0,0,0,5"/>
                                                    <ScrollViewer MaxHeight="150">
                                                        <ItemsControl ItemsSource="{Binding SavedReports}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Command="{Binding #RootControl.DataContext.UseSavedReportNameCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5,3">
                                                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Foreground="#0078D4"/>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Panel>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button Content="+ Adicionar" Background="#0D6EFD" Foreground="White" Padding="15,8" CornerRadius="6" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="Suporte Matriz" Command="{Binding AdicionarItemManualPorCategoriaCommand}" CommandParameter="Suporte Matriz"/>
                                        <MenuItem Header="Suporte Filiais" Command="{Binding AdicionarItemManualPorCategoriaCommand}" CommandParameter="Suporte Filiais"/>
                                        <MenuItem Header="Saída/Entrada - Estoque" Command="{Binding AdicionarItemManualPorCategoriaCommand}" CommandParameter="Saída e Entrada"/>
                                        <MenuItem Header="Outras Atividades" Command="{Binding AdicionarItemManualPorCategoriaCommand}" CommandParameter="Outras Atividades"/>
                                        <MenuItem Header="Plantão" Command="{Binding AdicionarItemManualPorCategoriaCommand}" CommandParameter="Plantão"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <!-- BOTÃO DE EXPORTAR COM MENU SUSPENSO -->
                            <Button Content="Exportar" Background="#0DCAF0" Foreground="Black" Padding="12,8" CornerRadius="6" FontWeight="SemiBold" Cursor="Hand" Margin="10,0,0,0">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="Copiar para Área de Transferência" Command="{Binding CopiarRelatorioCommand}"/>
                                        <MenuItem Header="Gerar PDF" Command="{Binding ExportarPdfCommand}"/>
                                        <MenuItem Header="Gerar Word" Command="{Binding ExportarWordCommand}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. ÁREA DOS CARDS -->
        <ScrollViewer Grid.Row="1" Padding="30" x:Name="CardsScrollViewer">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Relatorios}" x:Name="RelatoriosItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RelatorioItem">

                            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20"
                                    BoxShadow="0 2 8 0 #0A000000" BorderBrush="#E9ECEF" BorderThickness="1">

                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">

                                    <!-- ÁREA DAS TAGS (Categoria e Status) -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                                        <Border Background="#E9ECEF" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding Categoria}" FontSize="12" FontWeight="Bold" Foreground="#495057"/>
                                        </Border>

                                        <!-- A NOVA TAG DE STATUS COM COR DINÂMICA -->
                                        <Border Background="{Binding CorStatus}" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding StatusTag}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                        </Border>

                                        <TextBlock Text="{Binding Tecnico}" FontSize="12" FontWeight="SemiBold" Foreground="#6C757D" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>

                                    <!-- Botão Lixeira -->
                                    <Button Grid.Row="0" Grid.Column="1"
                                            Command="{Binding #RootControl.DataContext.RemoverItemCommand}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            Padding="5" Cursor="Hand" Margin="0,-5,-5,0">
                                        <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                  Foreground="#DC3545" Width="16" Height="16"/>
                                    </Button>
                                    <!-- Título do Card -->
                                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                             Text="{Binding Titulo}"
                                             Watermark="Digite o título da atividade..."
                                             FontWeight="Bold" FontSize="16" Foreground="#212529"
                                             Margin="0,0,0,10" Background="Transparent" BorderThickness="0,0,0,1"
                                             CornerRadius="0" Padding="0,0,0,5"/>

                                    <!-- Descrição do Card -->
                                    <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                             Text="{Binding Descricao}"
                                             Watermark="Descreva o que foi feito aqui..."
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="60" Background="#F8F9FA" BorderBrush="#DEE2E6"
                                             CornerRadius="6" Padding="10"/>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Espaço extra no final da lista para garantir que o último item seja totalmente visível -->
                <Panel Height="100" />
            </StackPanel>
        </ScrollViewer>

        <!-- OVERLAY DE NOTIFICAÇÃO -->
        <Border Grid.Row="1"
                IsVisible="{Binding IsNotificationVisible}"
                Background="#333"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,30"
                Padding="20,10"
                CornerRadius="8"
                BoxShadow="0 4 8 0 #40000000"
                ZIndex="999">
            <TextBlock Text="{Binding NotificationMessage}" Foreground="White" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>