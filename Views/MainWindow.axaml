<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RelatorioGLPIApp.ViewModels"
        x:Class="RelatorioGLPIApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Gerador de Relatórios GLPI"
        SystemDecorations="None"
        CanResize="True"
        Width="1280" Height="768"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, *">
        <!-- LINHA 0: Barra de Atualização (Só aparece se HasUpdate for TRUE) -->
        <Border Grid.Row="0" Background="#FFC107" Padding="10" IsVisible="{Binding HasUpdate}">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding UpdateMessage}"
                           VerticalAlignment="Center"
                           Foreground="Black"
                           FontWeight="SemiBold"/>

                <Button Grid.Column="1"
                        Content="Baixar Atualização"
                        Command="{Binding DownloadUpdateCommand}"
                        Background="#212529"
                        Foreground="White"
                        Padding="15,5"
                        CornerRadius="4"/>
            </Grid>
        </Border>
        <ContentControl Grid.Row="1" Content="{Binding PaginaAtual}" />
    </Grid>
</Window>

