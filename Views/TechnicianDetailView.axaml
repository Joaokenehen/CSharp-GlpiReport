<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RelatorioGLPIApp.ViewModels"
             xmlns:m="using:RelatorioGLPIApp.Models"
             x:Class="RelatorioGLPIApp.Views.TechnicianDetailView"
             x:DataType="vm:TechnicianDetailViewModel"
             Background="#F3F4F6"
             x:Name="RootControl">

    <UserControl.Styles>
        <Style Selector="Button.WindowButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.WindowButton:pointerover">
            <Setter Property="Background" Value="#E9ECEF"/>
        </Style>
        <Style Selector="Button.CloseButton:pointerover">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        <!-- Barra de Título com botão Voltar -->
        <Border Grid.Row="0" Background="White" BoxShadow="0 4 15 0 #0D000000" ZIndex="1">
            <Grid ColumnDefinitions="Auto, *, Auto" MinHeight="40" Name="TitleBar" PointerPressed="TitleBar_PointerPressed" Background="Transparent">
                <!-- Botão Voltar -->
                <Button Grid.Column="0" Command="{Binding GoBackCommand}" Background="Transparent" VerticalAlignment="Center" Margin="10,0,0,0">
                    <PathIcon Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" Width="24" Height="24" Foreground="#333"/>
                </Button>

                <!-- Título -->
                <TextBlock Grid.Column="1" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0">
                    <Run Text="Detalhes do Técnico: "/>
                    <Run Text="{Binding TechnicianName}" FontWeight="Normal"/>
                </TextBlock>

                <!-- Controles de Janela -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Name="MinimizeButton" Content="—" Classes="WindowButton" Click="MinimizeWindow"/>
                    <Button Name="MaximizeButton" Content="☐" Classes="WindowButton" Click="MaximizeWindow"/>
                    <Button Name="CloseButton" Content="✕" Classes="WindowButton CloseButton" Click="CloseWindow"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="10" Margin="30">
                <TextBlock Text="Chamados Solucionados" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding SolvedTickets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:TechnicianDetailTicket">
                            <StackPanel>
                                <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
                                        <!-- Botão para expandir/recolher -->
                                        <Button Grid.Column="0" Command="{Binding #RootControl.DataContext.ToggleConversationCommand}" CommandParameter="{Binding}" Background="Transparent" VerticalAlignment="Center" Padding="4" Margin="0,0,5,0">
                                            <!-- Círculo para dar um fundo visível ao ícone -->
                                            <Border CornerRadius="12" Width="24" Height="24" Background="Black">
                                                <PathIcon Width="16" Height="16" Data="{Binding IsExpanded, Converter={StaticResource BooleanToChevronConverter}}" Foreground="#333"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding Id, StringFormat='ID: {0}'}" FontWeight="Bold" Width="70" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Border Grid.Column="3" Background="{Binding Type, Converter={StaticResource TicketTypeToColorConverter}}" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding Type}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <!-- Painel da Conversa (visível quando expandido) -->
                                <Panel IsVisible="{Binding IsExpanded}" Margin="40,10,10,15">
                                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingConversation}" HorizontalAlignment="Stretch" Height="3" VerticalAlignment="Top"/>
                                    <ItemsControl ItemsSource="{Binding Conversation}" IsVisible="{Binding !IsLoadingConversation}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="m:TicketFollowup">
                                                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,5" Background="{Binding IsPrivate, Converter={StaticResource IsPrivateToBackgroundConverter}}">
                                                    <StackPanel>
                                                        <Grid ColumnDefinitions="*, Auto">
                                                            <TextBlock Grid.Column="0" FontWeight="Bold" Text="{Binding Author}" Foreground="{Binding IsPrivate, Converter={StaticResource IsPrivateToColorConverter}}"/>
                                                            <TextBlock Grid.Column="1" FontSize="11" Foreground="#666" Text="{Binding Date}"/>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Text="{Binding Content}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Nenhuma conversa encontrada para este chamado." IsVisible="{Binding !Conversation.Count, FallbackValue=False}" HorizontalAlignment="Center" Foreground="#888" Margin="10"/>
                                </Panel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Nenhum chamado solucionado encontrado para este técnico."
                           IsVisible="{Binding !SolvedTickets.Count}"
                           Foreground="#6C757D"
                           HorizontalAlignment="Center"
                           Margin="0,20"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>